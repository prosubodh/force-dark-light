{
  "name": "force-dark-light",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-browser extension allowing users to force dark or light mode toggle on any web page.",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "build:content": "vite build --config vite.content.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "smoke-test": "bash scripts/smoke_test.sh"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.0.8",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  }
}
